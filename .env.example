PORT=8080
AW_SECRET=replace-with-a-long-random-secret
AW_BASE_PATH=/anchor
AW_SHADOW_MODE=true
AW_BLOCK_DEPTH=3
AW_BLOCK_MINUTES=60
AW_REPEAT_BLOCK_MINUTES=1440
AW_QUARANTINE_MODE=decoy
AW_SESSION_TTL_MINUTES=30
AW_SESSION_BIND_IP=true
AW_TRUST_PROXY=false
# v1.4: OPTIONAL. Only enable behind a TLS proxy that strips/overwrites X-AW-JA4.
AW_TRUSTED_JA4_ENABLED=false
AW_DASHBOARD_ENABLED=true
AW_DASHBOARD_TOKEN=change-me
AW_LOG_FILE=./data/anchorweight-events.jsonl
AW_STATE_FILE=./data/anchorweight-state.json
# JSON remains the default. SQLite is an opt-in single-process backend on Node >=22.13.
# Stop AnchorWeight and back up data before enabling it. Original JSON is left untouched.
AW_STATE_BACKEND=json
AW_SQLITE_FILE=./data/anchorweight-state.sqlite

# Whole-site reverse proxy. Leave false until the origin is configured and tested.
AW_PROXY_ENABLED=false
AW_ORIGIN_URL=http://127.0.0.1:8081
AW_PROXY_TIMEOUT_MS=15000
AW_PUBLIC_SCHEME=https

# Robots blackhole: hidden link + robots.txt Disallow. In Shadow Mode this records only.
AW_BLACKHOLE_ENABLED=true
AW_BLACKHOLE_PATH=/anchor/blackhole
AW_BLACKHOLE_INJECT_LINK=true
AW_BLACKHOLE_MAX_RESPONSE_BYTES=2097152

# Bot DNA / behavioral scoring. Conservative default: observe only.
AW_SCORE_BLACKHOLE=100
AW_SCORE_ENFORCEMENT_ENABLED=false
AW_QUARANTINE_SCORE=100
AW_SCORE_LURE=5
AW_SCORE_TRAVERSAL=20
AW_SCORE_PROOF=40
AW_SCORE_INVALID=8
AW_SCORE_MISSING_UA=5
AW_SCORE_AUTOMATION_UA=15
AW_SCORE_UA_CHANGE=10
AW_SCORE_RAPID_BURST=10
AW_SCORE_SPOOFED_GOOD_BOT=25
AW_RAPID_REQUEST_MS=250
AW_RAPID_REQUEST_BURST=6

# v0.5.0 verified-good-bot controls.
AW_GOOD_BOT_VERIFICATION_ENABLED=true
AW_GOOD_BOT_CACHE_MINUTES=1440

# Optional Bot DNA policy overrides, comma-separated IDs copied from the dashboard.
# Explicit quarantine wins over verified-good-bot status; explicit allow bypasses enforcement.
AW_ALLOW_BOT_IDS=
AW_QUARANTINE_BOT_IDS=

# v0.6.0 campaign intelligence
AW_SCORE_SHARED_CANARY=20


# v0.8.0 operations maturity
# AW_PROFILE=shadow
AW_EVENT_RETENTION_DAYS=30
AW_EVENT_MAX_MB=50

# v0.9.0 production hardening
AW_ADMIN_RATE_LIMIT_PER_MINUTE=60
AW_CSRF_TTL_MINUTES=15
AW_ADMIN_BODY_MAX_BYTES=8192
AW_PROXY_BODY_MAX_BYTES=26214400
AW_ALLOW_QUERY_ADMIN_TOKEN=false
AW_AUDIT_ENABLED=true
AW_AUDIT_LOG_FILE=./data/anchorweight-audit.jsonl
AW_READINESS_ORIGIN_CHECK=true
AW_SHUTDOWN_GRACE_MS=10000

# v1.3 independently signed branches; set false for legacy link format.
AW_CANARY_BRANCH_COUNT=7
AW_CANARY_VARIANTS_ENABLED=true

# v1.6.0: OPTIONAL distributed evidence transport (disabled on upgrade).
# AW_INTELLIGENCE_ENABLED=true
# AW_INTELLIGENCE_SITE_ID=site_one
# AW_INTELLIGENCE_SITE_SECRET=generate-an-independent-32-plus-character-secret
# AW_INTELLIGENCE_HUB_URL=https://your-separate-hub.example/v1/evidence
# Hub instance only (a DIFFERENT Node app):
# AW_HUB_SITES_FILE=./data/intelligence-sites.json
# AW_HUB_ADMIN_TOKEN=generate-a-separate-32-plus-character-token
# AW_HUB_STATE_FILE=./data/intelligence-events.jsonl

# v1.7 operator wizard (off unless explicitly enabled in cPanel)
AW_SETUP_CONFIG_ENABLED=false
AW_SETUP_WRITES_ENABLED=false
# Set to this AnchorWeight installation's public hostname to reject self-origin loops
AW_SETUP_PUBLIC_HOST=
# Only exact, independently trusted HTTP(S) root origins (comma-separated)
AW_SETUP_ALLOWED_ORIGINS=

# v1.8 Gateway controls: OFF by default, separately from Bot DNA Shadow Mode.
AW_GATEWAY_ACCESS_ENABLED=false
AW_GATEWAY_RATE_ENABLED=false
AW_GATEWAY_SHADOW_MODE=true
AW_GATEWAY_ALLOW_IPS=
AW_GATEWAY_DENY_IPS=
AW_GATEWAY_RATE_PER_MINUTE=120
# Up to 16 JSON objects {"path":"/api/login","perMinute":10}; prefix segment matching.
AW_GATEWAY_RATE_PATHS=[]
AW_GATEWAY_HEALTH_ENABLED=false
AW_GATEWAY_HEALTH_INTERVAL_MS=30000
AW_GATEWAY_HEALTH_TIMEOUT_MS=2000
AW_GATEWAY_MAINTENANCE_ENABLED=false
AW_GATEWAY_MAINTENANCE_TITLE=Service temporarily unavailable
AW_GATEWAY_MAINTENANCE_MESSAGE=Please try again shortly.

# v1.9 opt-in multi-origin routing. Stored route definitions belong in private data/.
AW_ROUTES_ENABLED=false
AW_ROUTES_FILE=./data/anchorweight-routes.json
# Explicitly approve every additional route origin; set AW_SETUP_PUBLIC_HOST above.
AW_ROUTE_ALLOWED_ORIGINS=

# v2.1 unified gateway config (disabled by default; read guide before enabling)
AW_DECLARATIVE_ENABLED=false
AW_DECLARATIVE_WRITES_ENABLED=false
AW_DECLARATIVE_FILE=./data/anchorweight-gateway.json
# AW_SETUP_ALLOWED_ORIGINS=http://127.0.0.1:8081
# AW_ROUTE_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002

# v2.2 per-path APPLICATION authentication (not dashboard login). Off on upgrade.
# Use Node CLI to generate hashed credentials inside this private ./data file.
# Public HTTPS is required. Proxy access to the origin must not be bypassable.
AW_APP_AUTH_ENABLED=false
AW_APP_AUTH_FILE=./data/anchorweight-app-auth.json
# Existing AW_GATEWAY_RATE_PATHS supports path-specific request rates.

# v2.3: opt-in, independent per-origin circuit breakers and fallback mapping.
# Never enable a fallback until it is an equivalent, approved upstream.
AW_RESILIENCE_ENABLED=false
AW_RESILIENCE_FAILURE_THRESHOLD=3
AW_RESILIENCE_COOLDOWN_MS=30000
AW_RESILIENCE_HEALTH_ENABLED=false
AW_RESILIENCE_HEALTH_INTERVAL_MS=30000
AW_RESILIENCE_HEALTH_TIMEOUT_MS=2000
# AW_RESILIENCE_FALLBACKS_FILE=./data/anchorweight-fallbacks.json
# AW_RESILIENCE_ALLOWED_ORIGINS=http://127.0.0.1:9001/

# v2.4: opt-in authenticated live traffic stream. Per-route aggregates work when off.
AW_OBSERVATORY_LIVE_ENABLED=false
