[Unit]
Description=AnchorWeight crawler defense reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/anchorweight
EnvironmentFile=/etc/anchorweight/anchorweight.env
ExecStart=/usr/bin/node /opt/anchorweight/app.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/anchorweight/data /opt/anchorweight/backups /opt/anchorweight/reports

[Install]
WantedBy=multi-user.target
