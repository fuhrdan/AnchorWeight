{
  "name": "anchorweight",
  "version": "3.2.0-alpha.1",
  "description": "Autonomous traffic control and proof-of-crawl defense with Agent Identity, Bot DNA, bounded quarantine, investigation tooling, and reverse proxy protection.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node scripts/test-suite.js",
    "cli": "node bin/anchorweight.js",
    "release:check": "node scripts/release-check.js",
    "security:check": "npm audit --audit-level=high",
    "benchmark": "node scripts/benchmark.js",
    "test:unit": "node --test test/unit/*.test.js",
    "source:review": "node scripts/source-review.js",
    "release:verify": "node scripts/release-check.js --verify",
    "auth": "node bin/app-auth.js",
    "alerts": "node bin/alerts.js",
    "doctor": "node bin/operator.js doctor",
    "setup": "node bin/operator.js setup",
    "config:export": "node bin/operator.js export",
    "config:import": "node bin/operator.js import",
    "config:rollback": "node bin/operator.js rollback",
    "test:process-isolated": "node --test --test-concurrency=1",
    "rc:check": "node scripts/rc-hardening-check.js",
    "burnin:check": "node scripts/burn-in-check.js",
    "final:check": "node scripts/final-release-check.js",
    "ai-agents:check": "node scripts/ai-agent-check.js",
    "ai-agents:robots": "node scripts/ai-agent-robots.js",
    "ai-agents:verify": "node scripts/ai-agent-verification-check.js",
    "ai-agents:policy-check": "node scripts/ai-agent-verification-policy-check.js",
    "ai-agents:observability-check": "node scripts/ai-agent-observability-check.js",
    "ai-agents:policy-manager-check": "node scripts/ai-agent-policy-manager-check.js",
    "ai-agents:deployment-check": "node scripts/ai-agent-policy-deployment-check.js",
    "ai-agents:burnin-check": "node scripts/ai-agent-burnin-check.js",
    "ai-agents:beta-check": "node scripts/ai-agent-beta-check.js",
    "ai-agents:beta2-check": "node scripts/ai-agent-beta2-check.js",
    "ai-agents:production-check": "node scripts/ai-agent-production-check.js",
    "ai-agents:rc-check": "node scripts/ai-agent-rc-check.js",
    "ai-agents:ga-check": "node scripts/ai-agent-ga-check.js",
    "site-extraction:check": "node scripts/site-extraction-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "anchorweight": "./bin/anchorweight.js"
  }
}
